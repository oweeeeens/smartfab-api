# Server
PORT=3000

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=smartfab

# Set to true only in development: TypeORM creates/updates tables from the entities
DB_SYNCHRONIZE=true

# JWT
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1h

# Password given to the demo users created by "npm run seed"
SEED_DEFAULT_PASSWORD=ChangeMe123!
